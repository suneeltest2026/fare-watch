# Copy these names into Vercel -> Project -> Settings -> Environment Variables.
# NEVER put real values in this file or in GitHub.

# SerpApi (serpapi.com -> dashboard -> API key)
SERPAPI_KEY=

# Supabase (supabase.com -> your project -> Settings -> API Keys)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Choose your own long random texts for these two:
CRON_SECRET=
ADMIN_PASSWORD=

# Optional: safety limit on SerpApi searches per calendar month
MONTHLY_SEARCH_CAP=200
